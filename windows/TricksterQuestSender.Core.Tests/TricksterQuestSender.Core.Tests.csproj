<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs anywhere .NET 8 runs, including macOS:  dotnet test windows/TricksterQuestSender.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Run on whatever newer .NET is installed (e.g. only .NET 11 on this Mac). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TricksterQuestSender.Core\TricksterQuestSender.Core.csproj" />
  </ItemGroup>
</Project>
