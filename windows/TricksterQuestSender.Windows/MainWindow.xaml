<Window x:Class="QuestSenderWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuestSenderWin"
        Title="Trickster Quest Sender" Width="1000" Height="780" MinWidth="820" MinHeight="520"
        Topmost="{Binding AlwaysOnTop}" FontSize="13">
    <Window.Resources>
        <local:KindVisibilityConverter x:Key="KindVis"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True"/>
        <local:CountConverter x:Key="PageCount"/>
        <local:NonEmptyVisibilityConverter x:Key="NonEmptyVis"/>
        <SolidColorBrush x:Key="StripBrush" Color="#FFE4E4EA"/>
        <SolidColorBrush x:Key="PaneBrush" Color="#FFFAFAFC"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,4,0"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource PaneBrush}">

        <!-- Browser-style tab strip -->
        <Border DockPanel.Dock="Top" Background="{StaticResource StripBrush}" Padding="8,6,8,0"
                IsEnabled="{Binding IsIdle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder" Width="180" Height="32" Margin="0,0,2,0" Padding="12,0,4,0"
                                        CornerRadius="8,8,0,0" Background="Transparent" Cursor="Hand"
                                        Tag="{Binding}" MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                        ToolTip="คลิกเพื่อใช้แท็บนี้ · ดับเบิลคลิกเพื่อเปลี่ยนชื่อ · คลิกขวาดูเมนู">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="เปลี่ยนชื่อ" Tag="{Binding}" Click="RenameTab_Click"/>
                                            <MenuItem Header="ทำสำเนา" Tag="{Binding}" Click="DuplicateTab_Click"/>
                                            <Separator/>
                                            <MenuItem Header="ปิดแท็บ" Tag="{Binding}" Click="CloseTabMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="5,1"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="CloseTab_Click" ToolTip="ปิดแท็บ (Ctrl+Shift+T เปิดคืน)"/>
                                        <TextBlock DockPanel.Dock="Left" Text="●" Foreground="#FFD03A3A" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="แท็บนี้มาจากการบันทึกการเล่น"
                                                   Visibility="{Binding IsRecorded, Converter={StaticResource BoolVis}}"/>
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource NotBoolVis}}"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                     KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"
                                                     Tag="{Binding}"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PaneBrush}"/>
                                        <Setter TargetName="TabBorder" Property="TextElement.FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" FontSize="16" Padding="9,0" Margin="4,0,0,2" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Center" Click="AddTab_Click" ToolTip="แท็บใหม่ (Ctrl+T)"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Update banner -->
        <Border DockPanel.Dock="Top" Background="#FFDFF3E4" Padding="12,6"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="อัปเดตแล้วเปิดใหม่" Click="ApplyUpdate_Click"/>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="มีเวอร์ชันใหม่"/> <Run Text="{Binding UpdateVersion, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="ดาวน์โหลดไว้แล้ว"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Recording bar of the active tab -->
        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
            <Border Background="#1AD03A3A" CornerRadius="8" Padding="10,6"
                    Visibility="{Binding IsRecording, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="■ หยุดบันทึก (F8)" Margin="0,0,6,0" Click="StopRecording_Click"/>
                        <Button Content="ยกเลิก (Esc)" Click="CancelRecording_Click"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="●" Foreground="#FFD03A3A"/> <Run Text="กำลังบันทึกการเล่น"/> <Run Text="{Binding RecordedCount, Mode=OneWay}"/> <Run Text="การกระทำ — ในเกม: คลิก NPC → กด 1 จนจบ → คลิกพื้นที่ว่างปิดเควส → กด F8"/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <TextBlock Text="กำลังวิเคราะห์การเล่น…" Margin="2,4"
                       Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolVis}}"/>
            <Border Background="#0F000000" CornerRadius="8" Padding="10,6"
                    Visibility="{Binding ShowReRecord, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="● เริ่มบันทึกการเล่นใหม่" Click="Record_Click"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip="เล่นเองอีก 1 รอบ แล้วแทนที่ขั้นตอนเดิมของแท็บนี้ (Ctrl+Shift+R) — ของเดิมถูกแทนที่เมื่อบันทึกใหม่สำเร็จเท่านั้น"/>
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="● แท็บนี้มาจากการบันทึกการเล่น" Foreground="Gray"
                                   Visibility="{Binding ActiveTab.IsRecorded, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="ขั้นตอนในแท็บนี้ตั้งเอง" Foreground="Gray"
                                   Visibility="{Binding ActiveTab.IsRecorded, Converter={StaticResource NotBoolVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Bottom: run controls -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFDDDDE3" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="StartButton" Content="เริ่ม (F8)" MinWidth="110" Click="StartStop_Click"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="ส่งสำเร็จ"/> <Run Text="{Binding Completed, Mode=OneWay}"/> <Run Text="รอบ"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="วิธีใช้: เดินไปยืนใกล้ Rookie G / Part-Timer G ให้เห็นป้ายชื่อบนจอ → กด F8 หรือปุ่มเริ่ม → กด Esc หรือ F8 เมื่ออยากหยุด"/>
            </StackPanel>
        </Border>

        <!-- Settings of the active tab -->
        <Grid Margin="12,10,12,4" IsEnabled="{Binding IsIdle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ขั้นตอนใน 1 รอบ" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowEmptyChoices, Converter={StaticResource BoolVis}}">
                <Button Width="230" Height="120" Margin="8" Click="AddStep_Click">
                    <StackPanel>
                        <TextBlock Text="＋" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="เพิ่มขั้นตอนใหม่" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="ตั้งขั้นตอนเองทีละขั้น" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="230" Height="120" Margin="8" Click="Record_Click">
                    <StackPanel>
                        <TextBlock Text="●" FontSize="26" Foreground="#FFD03A3A" HorizontalAlignment="Center"/>
                        <TextBlock Text="บันทึกการเล่น" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="เล่นในเกมเอง 1 รอบ แอปจำและสร้างขั้นตอนให้" Foreground="Gray"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="กำลังบันทึก… เล่นในเกม 1 รอบแล้วกด F8"
                       Visibility="{Binding ShowRecordingHint, Converter={StaticResource BoolVis}}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Config.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#FFE2E2E8" BorderThickness="1" CornerRadius="6"
                                    Margin="0,0,0,6" Padding="8">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="↑" Style="{StaticResource IconButton}" Tag="{Binding}" Click="MoveUp_Click"/>
                                            <Button Content="↓" Style="{StaticResource IconButton}" Tag="{Binding}" Click="MoveDown_Click"/>
                                            <Button Content="ลบ" Style="{StaticResource IconButton}" Tag="{Binding}" Click="DeleteStep_Click"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="210" ItemsSource="{x:Static local:Ui.KindOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Kind}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                    </DockPanel>

                                    <WrapPanel Margin="0,6,0,0">
                                        <!-- Find NPC by name -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                                    Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=ClickNPC}">
                                            <TextBlock Text="ชื่อ NPC" Style="{StaticResource Label}" Margin="0,0,4,0"/>
                                            <TextBox Width="220" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="คั่นหลายชื่อด้วย ,"/>
                                            <TextBlock Text="จุดคลิกห่างจากชื่อ (pt)" Style="{StaticResource Label}"/>
                                            <TextBox Width="50" Text="{Binding NpcOffsetY}" ToolTip="ค่าติดลบ = คลิกเหนือป้ายชื่อ (ตรงตัว NPC)"/>
                                            <TextBlock Text="รอสูงสุด (ms)" Style="{StaticResource Label}"/>
                                            <TextBox Width="60" Text="{Binding TimeoutMs}"/>
                                        </StackPanel>

                                        <!-- Press option until the end -->
                                        <StackPanel Margin="0,2"
                                                    Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=DialogUntilEnd}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ปุ่ม" Style="{StaticResource Label}" Margin="0,0,4,0"/>
                                                <ComboBox Width="70" ItemsSource="{x:Static local:Ui.Keys}" SelectedItem="{Binding Key}"/>
                                                <TextBlock Text="หน้าสุดท้าย" Style="{StaticResource Label}"/>
                                                <TextBox Width="220" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="กดหน้านี้แล้วถือว่าจบรอบ (เว้นว่าง = จบเมื่อบทสนทนาปิด)"/>
                                                <TextBlock Text="หยุดทันทีถ้าเจอ" Style="{StaticResource Label}"/>
                                                <TextBox Width="160" Text="{Binding StopText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="รอบทสนทนาขึ้น (ms)" Style="{StaticResource Label}" Margin="0,0,4,0"/>
                                                <TextBox Width="60" Text="{Binding TimeoutMs}"/>
                                                <TextBlock Text="หน้าค้างนานกว่า (ms) กดซ้ำ" Style="{StaticResource Label}"/>
                                                <TextBox Width="60" Text="{Binding RetryMs}"/>
                                                <TextBlock Text="กดไม่เกิน (ครั้ง)" Style="{StaticResource Label}"/>
                                                <TextBox Width="40" Text="{Binding MaxPresses}"/>
                                                <TextBlock Text="{Binding Pages, Converter={StaticResource PageCount}}" Style="{StaticResource Label}"
                                                           Foreground="Gray" ToolTip="{Binding Pages}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Click a captured point -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                                    Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=ClickPoint}">
                                            <TextBlock Text="{Binding PointLabel}" Style="{StaticResource Label}" Margin="0,0,8,0" MinWidth="90"/>
                                            <Button Content="จับตำแหน่ง" Tag="{Binding}" Click="Capture_Click"
                                                    ToolTip="กดแล้วเอาเมาส์ไปวางที่จุดที่จะคลิกภายใน 3 วินาที"/>
                                        </StackPanel>

                                        <!-- Key -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                                    Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Key}">
                                            <TextBlock Text="ปุ่ม" Style="{StaticResource Label}" Margin="0,0,4,0"/>
                                            <ComboBox Width="70" ItemsSource="{x:Static local:Ui.Keys}" SelectedItem="{Binding Key}"/>
                                            <TextBlock Text="รอให้เจอข้อความนี้ก่อนกด" Style="{StaticResource Label}"/>
                                            <TextBox Width="220" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="เว้นว่าง = กดเลย"/>
                                            <TextBlock Text="รอสูงสุด (ms)" Style="{StaticResource Label}"/>
                                            <TextBox Width="60" Text="{Binding TimeoutMs}"/>
                                        </StackPanel>

                                        <!-- Wait for / click text -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                                    Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter='WaitText,ClickText'}">
                                            <TextBlock Text="ข้อความ" Style="{StaticResource Label}" Margin="0,0,4,0"/>
                                            <TextBox Width="220" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="รอสูงสุด (ms)" Style="{StaticResource Label}"/>
                                            <TextBox Width="60" Text="{Binding TimeoutMs}"/>
                                        </StackPanel>

                                        <TextBlock Text="คลิกตรงที่เมาส์ชี้อยู่ตอนกด F8" Foreground="Gray" Style="{StaticResource Label}" Margin="0"
                                                   Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=ClickStartMouse}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="รอหลังทำ (ms)" Style="{StaticResource Label}"/>
                                            <TextBox Width="60" Text="{Binding DelayAfterMs}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <Button Content="+ เพิ่มขั้นตอน" Click="AddStep_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ทดสอบหา NPC" Margin="0,0,6,0" Click="TestNpc_Click"/>
                    <Button Content="ทดสอบอ่านข้อความบนจอ" Click="TestOcr_Click"/>
                </StackPanel>
            </DockPanel>

            <TextBox Grid.Row="3" Margin="0,6,0,0" Height="90" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Text="{Binding OcrResult}"
                     Visibility="{Binding OcrResult, Converter={StaticResource NonEmptyVis}}"/>

            <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                <CheckBox Content="วนไม่จำกัด (หยุดเมื่อเช็กไม่ผ่าน)" IsChecked="{Binding Config.Unlimited}" VerticalAlignment="Center"/>
                <TextBlock Text="จำนวนรอบ" Style="{StaticResource Label}" Margin="14,0,4,0"/>
                <TextBox Width="50" Text="{Binding Config.Loops}"/>
                <TextBlock Text="สุ่มดีเลย์เพิ่ม (ms)" Style="{StaticResource Label}" Margin="14,0,4,0"/>
                <TextBox Width="50" Text="{Binding Config.JitterMs}"/>
                <TextBlock Text="รอก่อนเริ่ม (ms)" Style="{StaticResource Label}" Margin="14,0,4,0"/>
                <TextBox Width="50" Text="{Binding Config.StartDelayMs}"/>
                <CheckBox Content="หยุดถ้าผมขยับเมาส์" IsChecked="{Binding Config.StopIfMouseMoved}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <CheckBox Content="หน้าต่างลอยบนสุด" IsChecked="{Binding AlwaysOnTop}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <CheckBox Content="บันทึกเสร็จแล้วรันต่อเลย" IsChecked="{Binding AutoRunAfterRecording}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
        </Grid>
    </DockPanel>
</Window>
